.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store
# decompressed copies of results/*.jsonl.gz
results/noise.jsonl
results/overhead.jsonl
results/shared.jsonl
# generated figures and tables
figures/
# Local backups, temporary files and machine-specific diagnostics
.local/
.env
.env.*
!.env.example
# Regenerated summaries removed at the user's request; upstream copies remain in Git history
results/summary_realistic.json
results/summary_revision.json

# HPC execution outputs and disposable pytest workspaces
research/sync/runs/*/outputs/
research/sync/runs/*/pytest-tmp/

# New run source snapshots stay on HPC/local storage; tracked history is retained.
research/sync/runs/*/source_changes.patch
research/sync/runs/*/source_changes.patch.gz
research/sync/runs/*/source_untracked.tar.gz
# Incomplete transfer fragments are retained locally, not published.
research/sync/*.partial-*
# Nov10 full transfer inventories repeat the historical run list; preserve
# originals locally/on HPC and publish a SHA-bound compact index instead.
/research/sync/receipts/20261110T*.json
# Nov16/17 raw full inventories retained locally/HPC; SHA-bound compact index published.
/research/sync/receipts/20261116T*.json
/research/sync/receipts/20261117T*.json
# T1 full transfer receipts remain with the source records. Git carries a SHA-bound index.
/research/sync/receipts/20261118T*.json
/research/sync/receipts/20261118T*.json.gz
/research/sync/receipts/20261119T*-t1-*-scoped.json
# Empty temporary T1 metadata writes from interrupted finalization.
/research/sync/runs/hpc-masbench-t1*/*.tmp-*
# T2/T3 full transfer receipts and repeated source inventories stay in the run store.
/research/sync/receipts/20261125T*-t2-*-scoped.json
/research/sync/receipts/20261125T*-t3-*-scoped.json
/research/sync/runs/hpc-masbench-t2*-20261125/source_snapshot.json
/research/sync/runs/hpc-masbench-t3*-20261125/source_snapshot.json
